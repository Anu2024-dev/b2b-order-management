# ============================================================
# B2B Order Management Platform - Environment Variables Template
# Copy this file to .env and replace placeholder values.
# NEVER commit the actual .env file with real secrets!
# ============================================================

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_PORT=5173

# Database Connection (PostgreSQL)
# Either specify DATABASE_URL (common for cloud platforms like Render, Supabase, Neon):
# DATABASE_URL=postgresql://user:password@host:5432/b2b_order_db?sslmode=require
# Or specify individual parameters (default for local development):
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=b2b_order_db
DB_TEST_NAME=b2b_order_db_test
DB_SSL=false
# In production, TLS certificate verification is ENABLED by default (rejectUnauthorized: true).
# Set to 'false' only if your cloud provider uses self-signed certificates without a root CA:
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional custom CA certificate path or PEM string (e.g. for AWS RDS or custom CA bundles):
# DB_CA_CERT=

# JWT Configuration
# Generate a strong 64-character secret in production (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_minimum
JWT_EXPIRES_IN=24h

# Security & Rate Limiting
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Initial Bootstrap Credentials (used solely by database seed/bootstrap script in development)
BOOTSTRAP_ADMIN_NAME="Admin Officer"
BOOTSTRAP_ADMIN_EMAIL="admin@arrowdistributors.example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace_with_secure_bootstrap_admin_password"
BOOTSTRAP_ADMIN_COMPANY="Arrowstack Apex Distribution Pvt Ltd"

# Default Demo Customer Credentials (seeded for evaluation/demonstration)
DEMO_CUSTOMER_NAME="Customer Representative"
DEMO_CUSTOMER_EMAIL="purchasing@example.com"
DEMO_CUSTOMER_PASSWORD="replace_with_secure_customer_password"
DEMO_CUSTOMER_COMPANY="Apex Manufacturing & Robotics Ltd"
